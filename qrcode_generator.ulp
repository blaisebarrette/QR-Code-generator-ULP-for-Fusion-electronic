// Function to show help dialog
void showHelpDialog() {
    dlgDialog("Help") {
        dlgVBoxLayout {
            dlgTextView(usage);
            dlgHBoxLayout {
                dlgStretch(1);
                dlgPushButton(getText("BUTTON_OK")) dlgAccept();
                dlgStretch(1);
            }
        }
    };
}

void main(void) {
    // Initialize the embedded localization table for the user's language.
    initLocalizedTexts();

    // Initialize variables
    string Url = "";
    int Size = 500;  // Size in mils
    currentUnit = getDefaultGridUnit();  // Set initial unit based on grid preferences
    real displaySize = convertFromMils(Size, currentUnit);  // Convert for display
    
    // Layer selection (simplified to most commonly used layers)
    string LayerNames[];
    int LayerNumbers[];
    int SelectedLayer = 0;  // Initialize SelectedLayer here
    
    // Detect context and set available layers
    if (board) {
        currentContext = CONTEXT_BOARD;
        LayerNames[0] = "Top";
        LayerNames[1] = "Bottom";
        LayerNames[2] = "SilkscreenTop";
        LayerNames[3] = "SilkscreenBottom";
        LayerNames[4] = "DocumentTop";
        LayerNames[5] = "DocumentBottom";
        LayerNames[6] = "Document";
        LayerNumbers[0] = 1;
        LayerNumbers[1] = 16;
        LayerNumbers[2] = 21;
        LayerNumbers[3] = 22;
        LayerNumbers[4] = 51;
        LayerNumbers[5] = 52;
        LayerNumbers[6] = 48;
    } else if (schematic) {
        currentContext = CONTEXT_SCHEMATIC;
        LayerNames[0] = "Info";
        LayerNames[1] = "Guide";
        LayerNumbers[0] = 97;
        LayerNumbers[1] = 98;
    } else if (library) {
        if (package) {
            currentContext = CONTEXT_PACKAGE;
            LayerNames[0] = "Top";
            LayerNames[1] = "Bottom";
            LayerNames[2] = "SilkscreenTop";
            LayerNames[3] = "SilkscreenBottom";
            LayerNames[4] = "DocumentTop";
            LayerNames[5] = "DocumentBottom";
            LayerNames[6] = "Document";
            LayerNumbers[0] = 1;
            LayerNumbers[1] = 16;
            LayerNumbers[2] = 21;
            LayerNumbers[3] = 22;
            LayerNumbers[4] = 51;
            LayerNumbers[5] = 52;
            LayerNumbers[6] = 48;
        } else if (symbol) {
            currentContext = CONTEXT_SYMBOL;
            LayerNames[0] = "Symbols";
            LayerNames[1] = "Info";
            LayerNames[2] = "Guide";
            LayerNumbers[0] = 94;
            LayerNumbers[1] = 97;
            LayerNumbers[2] = 98;
        } else {
            dlgMessageBox("Error: In Library editor, this ULP must be run from either Footprint or Symbol editor.",
                         "OK");
            exit(1);
        }
    } else {
        dlgMessageBox("Error: This ULP must be run from a valid editor window.\n" +
                     "Supported contexts: Board, Schematic, Footprint, or Symbol",
                     "OK");
        exit(1);
    }
    
    // Dialog for input
    if (!dlgDialog(getText("TITLE")) {
        dlgHBoxLayout {
            dlgVBoxLayout {
                dlgGroup(getText("SETTINGS_GROUP")) {
                    dlgGridLayout {
                        dlgCell(0, 0, 0, 3) dlgLabel(getText("URL_LABEL"));
                        dlgCell(1, 0, 1, 3) dlgStringEdit(Url);
                        dlgCell(2, 0, 2, 3) dlgLabel(getText("SIZE_LABEL"));
                        dlgCell(3, 0, 3, 1) dlgRealEdit(displaySize, 0.25, 5000.0);
                        dlgCell(3, 2, 3, 3) dlgComboBox(UnitNames, currentUnit) {
                            int tempMils = convertToMils(displaySize, currentUnit);
                            displaySize = convertFromMils(tempMils, currentUnit);
                            dlgRedisplay();
                        }
                    }
                    dlgSpacing(10);
                    dlgLabel(getText("LAYER_LABEL"));
                    dlgComboBox(LayerNames, SelectedLayer);
                    dlgSpacing(10);
                    dlgLabel(getText("POSITION_NOTE"));
                }
                dlgSpacing(10);
                dlgHBoxLayout {
                    dlgStretch(1);
                    dlgPushButton("+" + getText("BUTTON_OK")) dlgAccept();
                    dlgPushButton("-" + getText("BUTTON_CANCEL")) dlgReject();
                    dlgStretch(1);
                }
                dlgHBoxLayout {
                    string versionText;
                    sprintf(versionText, "v%s", VERSION);
                    dlgLabel(versionText);
                    dlgStretch(1);
                    dlgPushButton("?") {
                        showHelpDialog();
                    }
                }
            }
        }
    } || Url == "") {
        dlgMessageBox(getText("ERROR_NO_URL"));
        exit(0);
    }
    
    // Convert final size to mils for QR code generation
    Size = convertToMils(displaySize, currentUnit);
    
    // Debug dialog
    int displayUnit = 0;  // Default to MICRON
    if (board) {
        board(B) displayUnit = B.grid.unit;
    } else if (library) {
        library(L) displayUnit = L.grid.unit;
    } else if (schematic) {
        schematic(S) displayUnit = S.grid.unit;
    }
    
    // Prepare script output file. The QR matrix itself is generated locally.
    string scriptFile = filedir(argv[0]) + "qr_script.scr";
    
    // Generate the QR code matrix natively (no network, no Python).
    int nLines = qrGenerate(Url, ECC_L, MODE_BYTE);
    if (nLines <= 0) {
        string err;
        if (QR_LAST_ERROR == -1) {
            sprintf(err, "%s\n\nThe URL is too long for the supported QR versions (V1-V10, ECC L).\n" +
                         "Please use a shorter URL or wait for a future release with extended version support.",
                    getText("ERROR_QR_GENERATION"));
        } else {
            sprintf(err, "%s\n\nDebug info:\n- ULP Version: %s\n- Internal error code: %d",
                    getText("ERROR_QR_GENERATION"), VERSION, QR_LAST_ERROR);
        }
        dlgMessageBox(err, "OK");
        exit(1);
    }
    
    // Reuse the local lines[] consumed by the Eagle script generation block.
    string lines[];
    int li;
    for (li = 0; li < nLines; li++) {
        lines[li] = QR_OUTPUT_LINES[li];
    }
    
    // Generate Eagle script
    output(scriptFile, "wD") {
        int qrSize = nLines;
        real moduleScale;
        real startXoffset;
        real startX = 0;
        real startY = 0;
        
        // Calculate module size and offset based on grid unit
        switch(displayUnit) {
            case 1:  // GRID_UNIT_MM
                // Keep size in mm
                moduleScale = (real(Size) * 0.0254) / real(qrSize);  // Convert target size from mils to mm
                startXoffset = 6.35;  // 250 mils = 6.35 mm
                break;
                
            case 2:  // GRID_UNIT_MIL
                // Keep in mils
                moduleScale = real(Size) / real(qrSize);
                startXoffset = 250.0;
                break;
                
            case 3:  // GRID_UNIT_INCH
                // Convert to inches
                moduleScale = (real(Size) / 1000.0) / real(qrSize);  // Convert target size from mils to inches
                startXoffset = 0.25;  // 250 mils = 0.25 inches
                break;
                
            default:
                // Fallback to mils
                moduleScale = real(Size) / real(qrSize);
                startXoffset = 250.0;
        }

        // Determine if bottom layer
        int isBottomLayer = (currentContext == CONTEXT_BOARD || currentContext == CONTEXT_PACKAGE) &&
                           (LayerNumbers[SelectedLayer] == 16 ||  // Bottom layer
                            LayerNumbers[SelectedLayer] == 22 ||  // Bottom silkscreen
                            LayerNumbers[SelectedLayer] == 52);   // Bottom documentation

        // Adjust startX based on layer
        startX = isBottomLayer ? startXoffset : -(moduleScale * qrSize + startXoffset);

        printf("# QR Code Generator Script\n");
        printf("CHANGE LAYER %d;\n", LayerNumbers[SelectedLayer]);
        printf("SET WIRE_BEND 2;\n");

        // Generate QR code rectangles in native grid units
        for (int row = 0; row < nLines; row++) {
            string line = lines[row];
            for (int col = 0; col < strlen(line); col++) {
                if (line[col] == '1') {
                    real x1 = startX + (col * moduleScale);
                    real y1 = startY + (row * moduleScale);
                    real x2 = x1 + moduleScale;
                    real y2 = y1 + moduleScale;

                    // Mirror X coordinates if bottom layer
                    if (isBottomLayer) {
                        real temp_x1 = x1;
                        x1 = -x2;
                        x2 = -temp_x1;
                    }

                    // Use %.4f for better precision
                    printf("RECT (%.4f %.4f) (%.4f %.4f);\n", x1, y1, x2, y2);
                }
            }
        }
    }
    
    // Execute script and exit
    exit("SCRIPT '" + scriptFile + "'");
} 